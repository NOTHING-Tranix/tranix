# Copy the lines you need into backend\.env (that file is NOT in git) and fill in your values.
# tools\backend-dev.ps1 reads backend\.env; docker compose reads the DB_* lines.

# Database (defaults shown; change only if your PostgreSQL uses other values)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tranixdb
DB_USERNAME=tranix
DB_PASSWORD=tranix

# Twilio SMS (dev testing)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM=+1xxxxxxxxxx
# While testing, every SMS goes to this number (your verified mobile). Remove it in production.
SMS_REDIRECT_TO=+91xxxxxxxxxx

# Firebase push (server): path to the service-account key file, kept outside the project
FCM_SERVICE_ACCOUNT_FILE=C:\Users\you\secrets\tranix-firebase.json
